+import { describe, expect, it } from "vitest";
+import { CliUsageError, parseCliArgs } from "../cli/args.js";
+
+describe("parseCliArgs --local", () => {
+  it("builds a local source and a placeholder PR ref", () => {
+    const options = parseCliArgs([
+      "--local",
+      "--repo",
+      "/tmp/some-repo",
+      "--base",
+      "abc",
+      "--head",
+      "def",
+      "--title",
+      "T",
+    ]);
+    expect(options.local).toEqual({
+      repo: "/tmp/some-repo",
+      base: "abc",
+      head: "def",
+      title: "T",
+      body: "",
+    });
+    expect(options.pr).toEqual({ host: "local", owner: "local", repo: "some-repo", number: 0 });
+    expect(options.serve).toBe(false);
+  });
+
+  it("refuses --serve, a PR URL, and a missing --head", () => {
+    const base = ["--local", "--repo", "/r", "--base", "a", "--title", "T"];
+    expect(() => parseCliArgs([...base, "--head", "b", "--serve"])).toThrow(CliUsageError);
+    expect(() => parseCliArgs([...base, "--head", "b", "https://github.com/o/r/pull/1"])).toThrow(
+      CliUsageError,
+    );
+    expect(() => parseCliArgs(base)).toThrow(/--head/);
+  });
+});
diff --git a/src/local/local-source.ts b/src/local/local-source.ts
new file mode 100644
index 0000000..a6b87a7
--- /dev/null
+++ b/src/local/local-source.ts
@@ -0,0 +1,80 @@
+import { mkdtemp } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { basename, join } from "node:path";
+import type { PrCheckout } from "../github/checkout.js";
+import { runCommand } from "../github/exec.js";
+import type { PrMetadata } from "../github/pr-fetcher.js";
+import type { PrRef } from "../github/pr-url.js";
+
+/** The input for local mode: a commit range in a local git repository, and a title and body. */
+export interface LocalSource {
+  /** Absolute path to a local git repository. */
+  repo: string;
+  /** Base commit. */
+  base: string;
+  /** Head commit. */
+  head: string;
+  title: string;
+  body: string;
+}
+
+/** The same git isolation as the PR checkout: no operator config, so no filters run. */
+const GIT_ISOLATION_ENV = { GIT_CONFIG_NOSYSTEM: "1", GIT_CONFIG_GLOBAL: "/dev/null" };
+
+function git(args: string[], cwd: string): Promise<string> {
+  return runCommand("git", args, { cwd, env: GIT_ISOLATION_ENV });
+}
+
+/** A placeholder PrRef for local mode. Nothing in local mode contacts this host. */
+export function localPrRef(source: LocalSource): PrRef {
+  return { host: "local", owner: "local", repo: basename(source.repo), number: 0 };
+}
+
+/** Builds the PR metadata from `git diff base..head` in the local repository. */
+export async function fetchLocalMetadata(source: LocalSource): Promise<PrMetadata> {
+  const base = (
+    await git(["rev-parse", "--verify", `${source.base}^{commit}`], source.repo)
+  ).trim();
+  const head = (
+    await git(["rev-parse", "--verify", `${source.head}^{commit}`], source.repo)
+  ).trim();
+  const [diff, names] = await Promise.all([
+    git(["diff", "--no-color", "--no-ext-diff", `${base}..${head}`], source.repo),
+    git(["diff", "--name-only", `${base}..${head}`], source.repo),
+  ]);
+  return {
+    title: source.title,
+    body: source.body,
+    files: names.split("\n").filter((line) => line.length > 0),
+    diff,
+    base: { ref: base, sha: base },
+    head: { ref: head, sha: head },
+  };
+}
+
+/** Makes a detached worktree of the local repository at the head commit, in a temp directory. */
+export async function createLocalCheckout(
+  source: LocalSource,
+  revisions: { base: { sha: string }; head: { sha: string } },
+): Promise<PrCheckout> {
+  const parent = await mkdtemp(join(tmpdir(), "tulip-local-"));
+  const dir = join(parent, "checkout");
+  await git(["worktree", "add", "--detach", dir, revisions.head.sha], source.repo);
+
+  async function getFileAt(sha: string, path: string): Promise<string | undefined> {
+    try {
+      return await git(["show", `${sha}:${path}`], source.repo);
+    } catch {
+      return undefined;
+    }
+  }
+
+  return {
+    dir,
+    getFileAtBase: (path) => getFileAt(revisions.base.sha, path),
+    getFileAtHead: (path) => getFileAt(revisions.head.sha, path),
+    cleanup: async () => {
+      await git(["worktree", "remove", "--force", dir], source.repo);
+    },
+  };
+}
