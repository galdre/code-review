@@ -20,6 +23,8 @@ export interface RunOptions {
   /** Run a local review server that posts a per-category PR comment via `gh` (docs/adr/0019).
    * Defaults to false (render a static page and exit). */
   serve: boolean;
+  /** Local mode: a commit range in a local repository, in place of a GitHub PR. */
+  local?: LocalSource;
 }
 
 /** Thrown for any invalid invocation; the message is shown to the user alongside usage info. */
@@ -36,6 +41,7 @@ export class VersionRequestedError extends Error {}
 export function usage(): string {
   return [
     "Usage: tulip <PR URL> [options]",
+    "       tulip --local --repo <path> --base <rev> --head <rev> --title <text> --body-file <file> [options]",
     "",
     "Explains a GitHub PR to reviewers using LLMs.",
     "",
@@ -48,6 +54,8 @@ export function usage(): string {
     "  --verbose             Show debug-level progress logging",
     "  --no-open             Don't automatically open the rendered page in your browser",
     "  --serve               Run a local review server; post a PR comment per category via gh",
+    "  --local               Explain a local commit range (base..head) in --repo; no GitHub access.",
+    "                        Needs --repo, --base, --head and --title; --body-file is optional.",
     "  -h, --help            Show this help and exit",
     "  -v, --version         Show version information and exit",
   ].join("\n");
@@ -63,6 +71,12 @@ export function parseCliArgs(argv: string[]): RunOptions {
     verbose?: boolean;
     "no-open"?: boolean;
     serve?: boolean;
+    local?: boolean;
+    repo?: string;
+    base?: string;
+    head?: string;
+    title?: string;
+    "body-file"?: string;
     help?: boolean;
     version?: boolean;
   };
@@ -75,6 +89,12 @@ export function parseCliArgs(argv: string[]): RunOptions {
         verbose: { type: "boolean" },
         "no-open": { type: "boolean" },
         serve: { type: "boolean" },
+        local: { type: "boolean" },
+        repo: { type: "string" },
+        base: { type: "string" },
+        head: { type: "string" },
+        title: { type: "string" },
+        "body-file": { type: "string" },
         help: { type: "boolean", short: "h" },
         version: { type: "boolean", short: "v" },
       },
@@ -91,6 +111,10 @@ export function parseCliArgs(argv: string[]): RunOptions {
     throw new VersionRequestedError();
   }
 
+  if (values.local) {
+    return parseLocalArgs(values, positionals);
+  }
+
   if (positionals.length === 0) {
     throw new CliUsageError("Missing required argument: <PR URL>");
   }
@@ -128,3 +152,47 @@ function parseDiffThreshold(raw: string | undefined): number {
   }
   return value;
 }
+
+function parseLocalArgs(
+  values: {
+    "diff-threshold"?: string;
+    verbose?: boolean;
+    "no-open"?: boolean;
+    serve?: boolean;
+    repo?: string;
+    base?: string;
+    head?: string;
+    title?: string;
+    "body-file"?: string;
+  },
+  positionals: string[],
+): RunOptions {
+  if (positionals.length > 0) {
+    throw new CliUsageError(`--local takes no PR URL: ${positionals.join(" ")}`);
+  }
+  if (values.serve) {
+    throw new CliUsageError("--serve posts comments to GitHub, so --local does not allow it.");
+  }
+  for (const name of ["repo", "base", "head", "title"] as const) {
+    if (!values[name]) {
+      throw new CliUsageError(`--local needs --${name}`);
+    }
+  }
+  const bodyFile = values["body-file"];
+  const local: LocalSource = {
+    repo: resolve(values.repo as string),
+    base: values.base as string,
+    head: values.head as string,
+    title: values.title as string,
+    body: bodyFile ? readFileSync(bodyFile, "utf8") : "",
+  };
+  return {
+    prUrl: "local",
+    pr: localPrRef(local),
+    diffThreshold: parseDiffThreshold(values["diff-threshold"]),
+    verbose: values.verbose ?? false,
+    open: !values["no-open"],
+    serve: false,
+    local,
+  };
+}
