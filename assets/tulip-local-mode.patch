 src/cli/index.ts             |  9 ++++
 src/local/local-args.test.ts | 36 ++++++++++++++++
 src/local/local-source.ts    | 80 ++++++++++++++++++++++++++++++++++++
 4 files changed, 193 insertions(+)
 create mode 100644 src/local/local-args.test.ts
 create mode 100644 src/local/local-source.ts

